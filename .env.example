# Copia como .env y ajusta.

# Ruta al archivo SQLite (relativa a donde corras uvicorn, o absoluta).
DATABASE_PATH=tortilleria.db

# Orígenes permitidos para CORS (frontend Next.js), separados por coma.
CORS_ORIGINS=http://localhost:3000

# Sincronización con Firestore para la app móvil (vacío = desactivado).
FIREBASE_CREDENTIALS_PATH=
DEALERS_COLLECTION=dealers
ORDERS_COLLECTION=orders

# Asistente IA (Claude). Vacío = el endpoint /assistant responde 400.
ANTHROPIC_API_KEY=
